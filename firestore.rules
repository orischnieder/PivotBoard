rules_version = '2';

// PivotBoard security rules.
// Publish from the Firebase console (Firestore Database -> Rules) - this file is not
// deployed automatically.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profiles are public to signed-in users; only the owner may write their own document,
    // with one exception: following someone increments `followersCount` on their document,
    // so that single key is writable by any signed-in user.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid)
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['followersCount']));
      allow delete: if false;

      // Follow graph and watchlist live under the user document. Both sides of a follow
      // are written by the follower, so followers/{followerUid} is writable by that user.
      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow write: if isSelf(uid);
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isSelf(followerUid);
      }

      // The owner sees everything; everyone else sees only entries marked public.
      //
      // For a `list` query this is not a filter - Firestore denies the whole query unless
      // every document it could return is readable. So a client reading someone else's
      // watchlist MUST constrain the query with whereEqualTo("isPublic", true); see
      // DatabaseManager.loadWatchlist.
      match /watchlist/{ticker} {
        allow read: if isSelf(uid) || resource.data.isPublic == true;
        allow write: if isSelf(uid);
      }

      // Notifications are created by whoever triggered them, read only by the owner.
      match /notifications/{notifId} {
        allow read, update, delete: if isSelf(uid);
        allow create: if isSignedIn();
      }
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid;
      // Any signed-in user may touch a post, but only to move the denormalized counters
      // (a like or a comment); everything else is author-only.
      allow update: if isSelf(resource.data.authorId)
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['likeCount', 'commentCount']);
      allow delete: if isSelf(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSelf(resource.data.authorId);
      }

      // Presence of the document is the like; the doc id is the liker's uid.
      match /likes/{uid} {
        allow read: if isSignedIn();
        allow write: if isSelf(uid);
      }
    }
  }
}

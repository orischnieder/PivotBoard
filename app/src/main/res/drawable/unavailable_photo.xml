<?xml version="1.0" encoding="utf-8"?>
<!--
  Glide placeholder / error drawable used by ImageLoader. This fills the chart area of every
  post card while the screenshot loads, so it is the most-seen surface in the app - a chart
  glyph on a brand-tinted plate rather than the stock broken-image mountain.

  Colours are @color/ resources, not ?attr/: Glide may inflate this with the application
  context, where theme attributes are not resolvable. Plain colour resources still honour
  -night, so values-night/colors.xml supplies the dark tones.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/placeholder_backdrop" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:gravity="center">
        <vector
            android:width="56dp"
            android:height="56dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:fillColor="@color/placeholder_glyph"
                android:pathData="M3.5,18.49l6,-6.01 4,4L22,6.92l-1.41,-1.41 -7.09,7.97 -4,-4L2,16.99z" />
        </vector>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular plate behind a notification's type glyph. Solid white so it can be tinted per
  notification type from the adapter via backgroundTintList.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
</shape>

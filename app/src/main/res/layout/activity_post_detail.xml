<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_LAY_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".activities.PostDetailActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detail_TB_toolbar"
        style="@style/Widget.PivotBoard.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/detail_title" />

    <include
        android:id="@+id/detail_LAY_state"
        layout="@layout/view_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_TB_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_LAY_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/detail_LAY_compose"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detail_TB_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/gutter">

            <!-- Author row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter">

                <ImageView
                    android:id="@+id/detail_IMG_avatar"
                    android:layout_width="@dimen/avatar_medium"
                    android:layout_height="@dimen/avatar_medium"
                    android:background="@drawable/bg_avatar_circle"
                    android:clipToOutline="true"
                    android:contentDescription="@string/cd_author_avatar"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_LBL_author"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.PivotBoard.ItemTitle"
                        tools:text="ori_trades" />

                    <TextView
                        android:id="@+id/detail_LBL_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.PivotBoard.Caption"
                        tools:text="2h ago" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ticker + setup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/space_m">

                <TextView
                    android:id="@+id/detail_LBL_ticker"
                    style="@style/Widget.PivotBoard.Chip.Ticker"
                    tools:text="NVDA" />

                <TextView
                    android:id="@+id/detail_LBL_setup"
                    style="@style/Widget.PivotBoard.Chip.Setup"
                    android:layout_marginStart="@dimen/space_s"
                    tools:text="Episodic Pivot" />
            </LinearLayout>

            <ImageView
                android:id="@+id/detail_IMG_chart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_height_detail"
                android:layout_marginTop="@dimen/space_m"
                android:contentDescription="@string/cd_post_chart"
                android:scaleType="centerCrop" />

            <!-- Full notes, not truncated -->
            <TextView
                android:id="@+id/detail_LBL_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/space_m"
                android:textAppearance="@style/TextAppearance.PivotBoard.Body"
                tools:text="Gapped up on earnings with volume well above average." />

            <TextView
                android:id="@+id/detail_LBL_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.PivotBoard.Typescale.BodySmall"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:text="#earnings #gap"
                tools:visibility="visible" />

            <!-- Actions. 8dp matches the feed card: text buttons carry their own inset. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_s">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_BTN_like"
                    style="@style/Widget.PivotBoard.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_like"
                    tools:text="12" />

                <TextView
                    android:id="@+id/detail_LBL_comment_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.PivotBoard.Caption"
                    tools:text="3 comments" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/space_s"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/detail_LBL_comments_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter"
                android:text="@string/detail_comments_header"
                android:textAppearance="@style/TextAppearance.PivotBoard.SectionHeader" />

            <TextView
                android:id="@+id/detail_LBL_no_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter"
                android:paddingBottom="@dimen/space_s"
                android:text="@string/detail_no_comments"
                android:textAppearance="@style/TextAppearance.PivotBoard.StateBody"
                android:visibility="gone" />

            <!-- Nested scrolling is off: the NestedScrollView owns the scroll. Comment
                 counts here are small, so the whole list renders at once. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/detail_RV_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!--
      Add comment. The divider lives inside this container rather than as a sibling so a
      single visibility toggle covers both - otherwise a stray rule would hang over an
      empty screen while the post is still loading.
    -->
    <LinearLayout
        android:id="@+id/detail_LAY_compose"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="?attr/colorOutlineVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/detail_LAY_comment"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/detail_hint_comment">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/detail_EDT_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_BTN_send"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:contentDescription="@string/detail_action_send"
                android:minWidth="@dimen/touch_target_min"
                android:minHeight="@dimen/touch_target_min"
                app:icon="@drawable/ic_send" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

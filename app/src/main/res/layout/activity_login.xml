<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_LAY_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ScrollView
        android:id="@+id/login_LAY_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/gutter_wide"
            android:paddingVertical="@dimen/space_xxl">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!--
              The mark sits in a circular badge rather than floating on the surface: it gives the
              logo a defined edge against both the light and dark backgrounds, and the brand ring
              reads as deliberate framing. cardCornerRadius is half the size, which is what makes
              a MaterialCardView a circle.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/login_CARD_logo"
                android:layout_width="@dimen/logo_badge_size"
                android:layout_height="@dimen/logo_badge_size"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="72dp"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="@dimen/logo_badge_stroke">

                <ImageView
                    android:id="@+id/login_IMG_logo"
                    android:layout_width="@dimen/logo_badge_mark"
                    android:layout_height="@dimen/logo_badge_mark"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_app_logo"
                    android:src="@drawable/logo_pivotboard" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/login_LBL_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:gravity="center"
                android:text="@string/login_welcome"
                android:textAppearance="@style/TextAppearance.PivotBoard.Typescale.HeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/login_LBL_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/login_sign_in"
                android:textAppearance="@style/TextAppearance.PivotBoard.Typescale.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_BTN_signin"
                style="@style/Widget.PivotBoard.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="@string/login_sign_in"
                android:textAppearance="@style/TextAppearance.PivotBoard.Typescale.TitleMedium" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/login_PRG_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:indeterminate="true"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Margin is modest: the weighted Space above already separates this from the CTA. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/login_CARD_disclaimer"
                style="@style/Widget.PivotBoard.Card.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl">

                <TextView
                    android:id="@+id/login_LBL_disclaimer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/gutter"
                    android:text="@string/disclaimer_not_advice"
                    android:textAppearance="@style/TextAppearance.PivotBoard.Disclaimer" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/post_CARD_root"
    style="@style/Widget.PivotBoard.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_xs">

        <!-- Author row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/card_padding"
            android:paddingTop="@dimen/card_padding">

            <ImageView
                android:id="@+id/post_IMG_avatar"
                android:layout_width="@dimen/avatar_small"
                android:layout_height="@dimen/avatar_small"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                android:contentDescription="@string/cd_author_avatar"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/post_LBL_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PivotBoard.ItemTitle"
                    tools:text="ori_trades" />

                <TextView
                    android:id="@+id/post_LBL_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.PivotBoard.Caption"
                    tools:text="2h ago" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ticker + setup type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/card_padding"
            android:paddingTop="@dimen/space_m">

            <TextView
                android:id="@+id/post_LBL_ticker"
                style="@style/Widget.PivotBoard.Chip.Ticker"
                tools:text="NVDA" />

            <TextView
                android:id="@+id/post_LBL_setup"
                style="@style/Widget.PivotBoard.Chip.Setup"
                android:layout_marginStart="@dimen/space_s"
                tools:text="Episodic Pivot" />
        </LinearLayout>

        <!-- Chart screenshot; deliberately full-bleed inside the card. -->
        <ImageView
            android:id="@+id/post_IMG_chart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chart_height_feed"
            android:layout_marginTop="@dimen/space_m"
            android:contentDescription="@string/cd_post_chart"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/post_LBL_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingHorizontal="@dimen/card_padding"
            android:paddingTop="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.PivotBoard.Body"
            tools:text="Gapped up on earnings with volume well above average." />

        <!--
          Reduced padding: Material text buttons carry their own horizontal inset, so 8dp
          here puts their label on the same optical line as the 16dp content above.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_s">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_BTN_like"
                style="@style/Widget.PivotBoard.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_like"
                tools:text="12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_BTN_comment"
                style="@style/Widget.PivotBoard.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_comment"
                tools:text="3" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Author-only; visibility is set in the adapter. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_BTN_menu"
                style="@style/Widget.PivotBoard.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/post_cd_menu"
                android:visibility="gone"
                app:icon="@drawable/ic_more_vert"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

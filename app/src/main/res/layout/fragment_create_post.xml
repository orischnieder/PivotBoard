<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_LAY_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/gutter">

        <!-- Ticker -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_LAY_ticker"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/create_hint_ticker"
            app:counterEnabled="true"
            app:counterMaxLength="6">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_EDT_ticker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textAllCaps="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Setup type -->
        <TextView
            android:id="@+id/create_LBL_setup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:text="@string/create_label_setup"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Spinner
            android:id="@+id/create_SPN_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min" />

        <!-- Chart image -->
        <TextView
            android:id="@+id/create_LBL_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:text="@string/create_label_chart"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/create_CARD_chart"
            style="@style/Widget.PivotBoard.Card.Panel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chart_height_feed"
            android:layout_marginTop="@dimen/space_s">

            <ImageView
                android:id="@+id/create_IMG_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_post_chart"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/create_LBL_chart_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/gutter"
                android:text="@string/create_chart_empty"
                android:textAppearance="@style/TextAppearance.PivotBoard.StateBody" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_BTN_pick_image"
            style="@style/Widget.PivotBoard.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/create_action_pick_image" />

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_LAY_notes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:hint="@string/create_hint_notes"
            app:counterEnabled="true"
            app:counterMaxLength="1000">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_EDT_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tags -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/create_LAY_tags"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gutter"
            android:hint="@string/create_hint_tags"
            app:helperText="@string/create_helper_tags">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/create_EDT_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Upload progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/create_PRG_upload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:visibility="gone"
            app:trackCornerRadius="@dimen/space_xs"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/create_LBL_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.PivotBoard.Caption"
            android:visibility="gone"
            tools:text="Uploading chart 40%"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_BTN_publish"
            style="@style/Widget.PivotBoard.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/create_action_publish" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

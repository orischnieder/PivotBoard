<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_LAY_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/profile_LAY_state"
        layout="@layout/view_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profile_LAY_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/gutter">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/space_xl">

                <FrameLayout
                    android:id="@+id/profile_LAY_avatar"
                    android:layout_width="@dimen/avatar_large"
                    android:layout_height="@dimen/avatar_large">

                    <ImageView
                        android:id="@+id/profile_IMG_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_circle"
                        android:clipToOutline="true"
                        android:contentDescription="@string/cd_author_avatar"
                        android:scaleType="centerCrop" />

                    <!-- Shown over the avatar while a new photo uploads. -->
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/profile_PRG_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:visibility="gone"
                        app:indicatorSize="52dp"
                        app:trackThickness="@dimen/space_xs"
                        tools:visibility="visible" />

                    <!-- Own profile only; enabled in code. -->
                    <ImageView
                        android:id="@+id/profile_IMG_avatar_edit"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_avatar_edit"
                        android:contentDescription="@string/profile_cd_change_photo"
                        android:padding="5dp"
                        android:src="@drawable/ic_camera"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSecondary"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Counts -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!--
                      Not clickable, unlike the two beside it, but it carries the same
                      padding and min height so all three numbers share a baseline.
                    -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <TextView
                            android:id="@+id/profile_LBL_posts_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PivotBoard.MetricValue"
                            tools:text="12" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_posts"
                            android:textAppearance="@style/TextAppearance.PivotBoard.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_LAY_followers"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <TextView
                            android:id="@+id/profile_LBL_followers_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PivotBoard.MetricValue"
                            tools:text="48" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_followers"
                            android:textAppearance="@style/TextAppearance.PivotBoard.Caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profile_LAY_following"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_horizontal"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/space_xs">

                        <TextView
                            android:id="@+id/profile_LBL_following_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.PivotBoard.MetricValue"
                            tools:text="7" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_label_following"
                            android:textAppearance="@style/TextAppearance.PivotBoard.Caption" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profile_LBL_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter"
                android:textAppearance="@style/TextAppearance.PivotBoard.MetricValue"
                tools:text="Ori Schnieder" />

            <TextView
                android:id="@+id/profile_LBL_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="2dp"
                android:textAppearance="@style/TextAppearance.PivotBoard.StateBody"
                tools:text="\@ori_trades" />

            <TextView
                android:id="@+id/profile_LBL_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.PivotBoard.Body"
                android:visibility="gone"
                tools:text="Trading episodic pivots since 2021."
                tools:visibility="visible" />

            <!-- Follow / Unfollow, or Edit profile on your own page -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_BTN_action"
                style="@style/Widget.PivotBoard.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginTop="@dimen/gutter"
                tools:text="Follow" />

            <!--
              Secondary to the follow action above, so it is a centred text button rather
              than a second full-width bar - two stacked filled-width buttons read as two
              equally important choices.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_BTN_watchlist"
                style="@style/Widget.PivotBoard.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/watchlist_action_view" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider_height"
                android:layout_marginTop="@dimen/gutter"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/profile_LBL_posts_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter"
                android:text="@string/profile_posts_header"
                android:textAppearance="@style/TextAppearance.PivotBoard.SectionHeader" />

            <TextView
                android:id="@+id/profile_LBL_no_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="@dimen/gutter"
                android:paddingBottom="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.PivotBoard.StateBody"
                android:visibility="gone"
                tools:text="No posts yet." />

            <!--
              4dp + the card's own 12dp margin puts the card edge on this screen's 16dp
              gutter, so the posts line up with the name and headers above them.
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/profile_RV_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/list_padding_vertical"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/space_xs" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

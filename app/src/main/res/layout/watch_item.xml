<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/watch_CARD_root"
    style="@style/Widget.PivotBoard.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/space_xs">

        <TextView
            android:id="@+id/watch_LBL_ticker"
            style="@style/Widget.PivotBoard.Chip.Ticker"
            tools:text="NVDA" />

        <TextView
            android:id="@+id/watch_LBL_added"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.PivotBoard.Caption"
            tools:text="added 3d ago" />

        <!-- Owner-only controls; hidden when viewing someone else's list. -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/watch_SW_public"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/watchlist_cd_public_toggle"
            android:minHeight="@dimen/touch_target_min" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/watch_BTN_remove"
            style="@style/Widget.PivotBoard.Button.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/watchlist_cd_remove"
            app:icon="@drawable/ic_delete" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

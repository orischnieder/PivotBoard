<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.PivotBoard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorOnPrimary">@color/on_primary_light</item>
        <item name="colorPrimaryContainer">@color/primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container_light</item>

        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container_light</item>

        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorOnBackground">@color/on_background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>

        <!--
          Card and sheet fills. Kept separate from colorSurfaceVariant, which is a divider
          tone: using one token for both made filled cards render lighter than the surface
          they sit on in dark mode.
        -->
        <item name="colorSurfaceContainerLow">@color/surface_container_low_light</item>
        <item name="colorSurfaceContainer">@color/surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest_light</item>

        <item name="colorOutline">@color/outline_light</item>
        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">@color/on_error_light</item>
        <item name="colorErrorContainer">@color/error_container_light</item>
        <item name="colorOnErrorContainer">@color/on_error_container_light</item>

        <!--
          Typeface. The textAppearance* attributes are what Material widgets resolve, so
          repointing them is what carries Manrope into buttons, tabs, the bottom bar, text
          fields and dialogs; the two fontFamily items catch plain views that have no text
          appearance at all. See the Typescale block in styles.xml.
        -->
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.PivotBoard.Typescale.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.PivotBoard.Typescale.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.PivotBoard.Typescale.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.PivotBoard.Typescale.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.PivotBoard.Typescale.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.PivotBoard.Typescale.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.PivotBoard.Typescale.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.PivotBoard.Typescale.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.PivotBoard.Typescale.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.PivotBoard.Typescale.LabelSmall</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.PivotBoard" parent="Base.Theme.PivotBoard" />

    <!--
      Splash keeps the brand background behind the logo.

      windowSplashScreenAnimatedIcon is deliberately NOT set: leaving it unset makes the
      Android 12+ system splash fall back to the launcher icon, which is exactly what we
      want it to show. Only the background is overridden, so the system splash and this
      activity share one colour and there is no white flash between them.
    -->
    <style name="Theme.PivotBoard.Splash" parent="Theme.PivotBoard">
        <item name="android:windowBackground">@color/brand_navy</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">
            @color/brand_navy
        </item>
        <!-- Light icons: the splash plate is navy in both modes. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Single source of truth for the app's spacing and sizing scale. Screens should reference
  these rather than repeating literals, so a spacing change is one edit instead of twenty.
-->
<resources>

    <!-- Spacing scale -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>
    <dimen name="space_xl">24dp</dimen>
    <dimen name="space_xxl">32dp</dimen>

    <!-- Screen gutters. Every screen's content aligns to gutter; login gets the wide one. -->
    <dimen name="gutter">16dp</dimen>
    <dimen name="gutter_wide">24dp</dimen>

    <!--
      Cards. A card is inset from the screen gutter by design, so its interior does not
      align with full-bleed screen content — what matters is that every card in the app
      uses the same margin and the same padding. Previously these ranged 12+12 to 12+16.
    -->
    <dimen name="card_margin_horizontal">12dp</dimen>
    <dimen name="card_margin_vertical">6dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_radius">16dp</dimen>

    <!--
      Elevation. Enough to cast a readable shadow in light mode without the cards looking like
      they are hovering; in dark mode Material's surface tint does the same job, since a shadow
      on a dark background is close to invisible. Panels (the login disclaimer, the create-post
      chart well) stay at 0 on purpose - they are recesses, not raised surfaces.
    -->
    <dimen name="card_elevation">3dp</dimen>
    <dimen name="button_elevation">2dp</dimen>

    <!-- Buttons -->
    <dimen name="button_radius">16dp</dimen>
    <dimen name="button_min_height">48dp</dimen>
    <dimen name="button_min_height_large">56dp</dimen>

    <!-- Login logo badge: the ring is sized around the 96dp mark it encloses. -->
    <dimen name="logo_badge_size">144dp</dimen>
    <dimen name="logo_badge_mark">96dp</dimen>
    <dimen name="logo_badge_stroke">1.5dp</dimen>

    <!-- Avatars -->
    <dimen name="avatar_small">40dp</dimen>
    <dimen name="avatar_medium">48dp</dimen>
    <dimen name="avatar_large">80dp</dimen>

    <!-- Chips: a shared min height keeps the ticker and setup chips the same size when
         they sit side by side, despite their different text sizes. -->
    <dimen name="chip_min_height">30dp</dimen>
    <dimen name="chip_padding_horizontal">10dp</dimen>
    <dimen name="chip_radius">8dp</dimen>

    <!-- Lists -->
    <dimen name="list_item_min_height">64dp</dimen>
    <dimen name="list_padding_vertical">6dp</dimen>
    <dimen name="list_padding_bottom">12dp</dimen>

    <!-- Icons -->
    <dimen name="icon_size">24dp</dimen>
    <dimen name="icon_container_size">40dp</dimen>
    <dimen name="touch_target_min">48dp</dimen>

    <!-- Images -->
    <dimen name="chart_height_feed">200dp</dimen>
    <dimen name="chart_height_detail">240dp</dimen>

    <!-- States -->
    <dimen name="empty_state_icon">72dp</dimen>
    <dimen name="empty_state_padding">32dp</dimen>

    <dimen name="divider_height">1dp</dimen>

</resources>
